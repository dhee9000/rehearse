# ── Required ────────────────────────────────────────────────────────────────
# Script parsing (Claude via the Vercel AI SDK)
ANTHROPIC_API_KEY=sk-ant-...
# Scene-partner voices
ELEVENLABS_API_KEY=sk_...

# ── Storage ─────────────────────────────────────────────────────────────────
# Leave both unset and Rehearse runs on SQLite + the local filesystem, which is
# the intended way to use it on your own machine.
#
# Set DATABASE_URL to run on Postgres instead. Use a POOLED connection string
# (Vercel Postgres / Neon give you a `-pooler` host) so serverless instances
# don't exhaust the server's connection limit.
# DATABASE_URL=postgres://user:pass@host-pooler.region.aws.neon.tech/db?sslmode=require
#
# Set a Blob token to keep rendered audio in Vercel Blob instead of on disk.
# Required for any hosted deployment — a serverless filesystem is ephemeral.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
# BLOB_BASE_URL=https://<store-id>.public.blob.vercel-storage.com

# ── Optional overrides ──────────────────────────────────────────────────────
# ANTHROPIC_MODEL=claude-opus-5
# ELEVENLABS_MODEL_ID=eleven_v3
# DATA_DIR=data
# DATABASE_POOL_MAX=3

# ── Accounts (Clerk) ────────────────────────────────────────────────────────
# `npx clerk@latest link` then `npx clerk@latest env pull` writes both of these.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
